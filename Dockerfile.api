# Landpot API (src/api, docs/LandpotAPI.md): one small Node process with a
# SQLite file. Built from the same workspace as the game server image.
FROM node:24-slim AS base
WORKDIR /usr/src/app
RUN npm install --global --ignore-scripts npm@12.1.0

FROM base AS prod-deps
ENV HUSKY=0
ENV NPM_CONFIG_IGNORE_SCRIPTS=1
COPY package*.json .npmrc ./
COPY packages/engine/package.json ./packages/engine/
COPY packages/engine-api/package.json ./packages/engine-api/
COPY packages/engine-lib/package.json ./packages/engine-lib/
COPY packages/shared/package.json ./packages/shared/
COPY packages/zbin/package.json ./packages/zbin/
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --ignore-scripts

FROM base
COPY --from=prod-deps /usr/src/app/node_modules ./node_modules
COPY package*.json tsconfig.json tsconfig.base.json ./
COPY packages ./packages
COPY src/api ./src/api
COPY resources ./resources
# Pot settlement replays matches with the game server's own replayer
# (src/server/WinnerReplay.ts, a subprocess) and needs the map binaries it
# reads from resources/maps when there is no built asset manifest.
COPY src/server ./src/server

ENV LANDPOT_API_PORT=8787 \
    LANDPOT_DATA_DIR=/data
RUN mkdir -p /data && chown node:node /data
VOLUME /data
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s \
    CMD node -e "fetch('http://127.0.0.1:'+process.env.LANDPOT_API_PORT+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node_modules/.bin/tsx", "src/api/Server.ts"]
